# npm run dev supplies the development-only demo/local-test flags and ephemeral RPC values.
# Do not copy Gymaf credentials, database links, sessions or Stripe identifiers.
PHYSIX_DEMO=
PHYSIX_LOCAL_BACKEND=
# Generated per launch; never hard-code or expose the RPC secret to browser code.
PHYSIX_LOCAL_RPC_SECRET=
PHYSIX_LOCAL_RPC_PORT=
PHYSIX_APP_ORIGIN=
# No hosted PhysiX identity, scheduling or payment provider is configured.
# The following names are for inherited isolated loopback HTTP contract fixtures only.
PHYSIX_ISOLATED_CONTRACT_TESTS=
APP_ORIGIN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
