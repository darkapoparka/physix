# Local synthetic preview: npm run dev sets PHYSIX_DEMO=1 explicitly.
# Demo routes are always disabled in production, even when this flag is set.
PHYSIX_DEMO=
# No database, patient accounts, live services or payment provider are configured.
# Never copy Gymaf .env.local, CLI links, credentials, customer IDs or sessions.
# The following names exist ONLY for inherited isolated loopback HTTP contract tests.
PHYSIX_ISOLATED_CONTRACT_TESTS=
APP_ORIGIN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Do not configure hosted values here until the PhysiX backend adapter is implemented.